{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restricted agent patch v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 1000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "op": {
        "enum": [
          "add",
          "replace",
          "remove",
          "test"
        ]
      },
      "path": {
        "type": "string",
        "pattern": "^/(executiveSummary|program|dimensions|investigations|findings|evidence|risks|questions|alternatives|estimates|gates|decisions|recommendations|activities)(/[^/]+)*$"
      },
      "value": {}
    },
    "required": [
      "op",
      "path"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "op": {
              "enum": [
                "add",
                "replace",
                "test"
              ]
            }
          }
        },
        "then": {
          "required": [
            "value"
          ]
        }
      }
    ]
  }
}
